# Copy to .env and fill in real values. Never commit the real .env file.

# Comma-separated list of valid API keys for the FIREWING API.
# Generate strong random keys, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIREWING_API_KEYS=

# Separate, higher-privilege key for /v1/admin/* routes (key management,
# request stats). Required to use the admin dashboard (webui/admin.html).
# Leave unset to disable the admin API entirely.
FIREWING_ADMIN_KEY=

# Optional overrides (see configs/firewing.example.yaml for the full set)
FIREWING_API_PORT=8000
FIREWING_MODEL_DEVICE=auto
FIREWING_LOGGING_LEVEL=INFO
